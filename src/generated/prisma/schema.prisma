/**
 * Prisma Schema for the Fundación NICE 2025 application.
 * This schema defines the database models and their relationships.
 * @module PrismaSchema
 */

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * Enum representing the different categories of posts in the application.
 * Each category represents a different section or program of the foundation.
 */
enum Category {
  VILLA_DE_LOS_NINOS // Villa de los Niños program
  SCHOLAS_OCURRENTES // Scholas Ocurrentes program
  LUDICA // Lúdica program
  FUNDACION_TELETON // Fundación Teletón partnership
  FUNDACION_1111 // Fundación 1111 partnership
}

/**
 * Model representing a blog post or article in the application.
 * Posts can be associated with different categories and contain multiple images and text blocks.
 */
model Post {
  id         Int      @id @default(autoincrement())
  title      String // The main title of the post
  cover      String // Main cover image URL
  createdAt  DateTime @default(now())
  category   Category // The category this post belongs to
  paragraph1 String // First text block of the post
  image1     String? // First optional image URL
  image2     String? // Second optional image URL
  paragraph2 String? // Second optional text block
  image3     String? // Third optional image URL
  image4     String? // Fourth optional image URL
  buttonLink String? // Optional external link (e.g., to an album)
  published  Boolean  @default(false) // Whether the post is visible to the public
  updatedAt  DateTime @updatedAt
}

/**
 * Model representing an administrator user in the application.
 * Admins can create, edit, and manage posts in the system.
 */
model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique // Unique username for login
  password  String // Hashed password
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Model representing a contact form message submission.
 * Stores messages sent through the website's contact form.
 */
model Message {
  id        Int      @id @default(autoincrement())
  name      String // Sender's name
  email     String // Sender's email address
  subject   String // Message subject
  message   String? // Message content (optional)
  read      Boolean  @default(false) // Whether the message has been read
  createdAt DateTime @default(now()) // When the message was sent
  updatedAt DateTime @updatedAt
}

model Numbers {
  id          Int      @id @default(autoincrement())
  icon        String // Store the icon path (e.g. "/logos/cifras1.svg")
  number      String // The number/value (e.g. "190,000")
  description String // The description text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
